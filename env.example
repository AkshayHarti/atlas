# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
# ATLAS_HOSTED_MODEL=gemini-2.5-flash

# ATLAS_TIMEOUT_MS=180000
